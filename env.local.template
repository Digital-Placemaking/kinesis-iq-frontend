# ============================================================================
# KINESISIQ FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.local (in the same directory)
# 2. Fill in the values below with your actual credentials
# 3. Never commit .env.local to git (it's already in .gitignore)
#
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get these from: Supabase Dashboard → Settings → API
# 
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL
#   Example: https://abcdefghijklmnop.supabase.co
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public/anonymous key (safe to expose in frontend)
#   This is the "anon" or "public" key from Supabase
#
# SUPABASE_SERVICE_ROLE_KEY: Service role key (KEEP SECRET - server-side only!)
#   This is the "service_role" key - NEVER expose this in client-side code
#   Used for: Analytics tracking, admin operations that bypass RLS
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# SITE CONFIGURATION (REQUIRED)
# ============================================================================
# NEXT_PUBLIC_SITE_URL: The public URL of your application
#   For local development: http://localhost:3000
#   For production: https://yourdomain.com
#   Used for: OAuth redirects, email links
# ============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# UPSTASH REDIS CONFIGURATION (IMPORTANT - for rate limiting)
# ============================================================================
# Get these from: https://upstash.com → Create Database → REST API
#
# UPSTASH_REDIS_REST_URL: Your Redis REST API endpoint
#   Example: https://your-db-name.upstash.io
#
# UPSTASH_REDIS_REST_TOKEN: Your Redis REST API token
#
# What it's used for:
#   - Rate limiting (prevent abuse of email submissions, coupon issuance)
#   - Survey completion tracking (prevent duplicate submissions)
#
# Note: If not configured, rate limiting will fail open (allow all requests)
# ============================================================================

UPSTASH_REDIS_REST_URL=https://your-redis-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# ============================================================================
# RESEND EMAIL CONFIGURATION (IMPORTANT - for sending emails)
# ============================================================================
# Get this from: https://resend.com → API Keys → Create API Key
#
# RESEND_API_KEY: Your Resend API key
#   Format: re_xxxxxxxxxxxxx
#
# What it's used for:
#   - Contact form submissions
#   - Mass email campaigns to collected email addresses
#
# Note: If not configured, email features will show error messages
# ============================================================================

RESEND_API_KEY=re_your-api-key-here

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (OPTIONAL - for email collection)
# ============================================================================
# Get these from: Google Cloud Console → APIs & Services → Credentials
#
# GOOGLE_OAUTH_CLIENT_ID: OAuth 2.0 Client ID
# GOOGLE_OAUTH_CLIENT_SECRET: OAuth 2.0 Client Secret
#
# Setup steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project or select existing
#   3. Enable "Google+ API" or "People API"
#   4. Go to Credentials → Create Credentials → OAuth 2.0 Client ID
#   5. Configure OAuth consent screen
#   6. Add authorized redirect URI: http://localhost:3000/auth/oauth-callback
#   7. Copy Client ID and Client Secret here
#
# What it's used for:
#   - "Sign in with Google" button on tenant landing pages
#   - Collects visitor email addresses (does NOT create Supabase Auth users)
#
# Note: This is separate from Supabase OAuth. This is for email collection only.
# ============================================================================

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# GOOGLE WALLET CONFIGURATION (OPTIONAL - for digital wallet passes)
# ============================================================================
# Get these from: Google Wallet API setup
#
# NEXT_GOOGLE_WALLET_ISSUER_ID: Your Google Wallet issuer ID
# NEXT_GOOGLE_WALLET_CLASS_ID: Wallet class ID (default: "digital_placemaking_coupon")
# NEXT_GOOGLE_SERVICE_ACCOUNT_EMAIL: Service account email from Google Cloud
# NEXT_GOOGLE_PRIVATE_KEY: Service account private key (keep secret!)
#
# What it's used for:
#   - Generating Google Wallet passes for coupons
#   - Adding coupons to users' digital wallets
#
# Note: Only needed if you want Google Wallet integration
# ============================================================================

# NEXT_GOOGLE_WALLET_ISSUER_ID=your-issuer-id
# NEXT_GOOGLE_WALLET_CLASS_ID=digital_placemaking_coupon
# NEXT_GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# NEXT_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Variables starting with NEXT_PUBLIC_ are exposed to the browser
#    - Safe to use in client-side code
#    - Never put secrets here!
#
# 2. Variables without NEXT_PUBLIC_ are server-side only
#    - Only accessible in server components, server actions, API routes
#    - Safe to put secrets here (like SUPABASE_SERVICE_ROLE_KEY)
#
# 3. After adding/changing environment variables:
#    - Restart the dev server (Ctrl+C, then npm run dev)
#    - Environment variables are loaded at startup
#
# 4. For production deployment (Vercel):
#    - Add these same variables in Vercel project settings
#    - Update NEXT_PUBLIC_SITE_URL to your production domain
#    - Never commit .env.local to git
#
# ============================================================================

